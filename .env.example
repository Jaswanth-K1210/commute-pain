# .env.local (dev) and Vercel env vars (site) need all of these.
# GitHub Secrets (logger) only need TOMTOM_API_KEY + MONGODB_URI.
TOMTOM_API_KEY=your-tomtom-key
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=commute_pain
SESSION_SECRET=long-random-string   # `openssl rand -base64 32`; signs logins + peppers PINs. changing it logs everyone out & breaks all PINs
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxx
