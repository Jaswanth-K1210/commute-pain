# Same values go in: .env.local (local dev), Vercel env vars (site), GitHub Secrets (logger: first three only)
TOMTOM_API_KEY=your-tomtom-key
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role-or-sb_secret-key   # server-only, never prefix with NEXT_PUBLIC_
SESSION_SECRET=long-random-string                     # `openssl rand -base64 32`; signs logins + peppers PINs. changing it logs everyone out & breaks all PINs
